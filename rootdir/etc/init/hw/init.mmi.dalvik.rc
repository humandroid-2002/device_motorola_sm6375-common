on property:ro.vendor.hw.ram=4GB
    setprop dalvik.vm.heapstartsize 24m
    setprop dalvik.vm.heapgrowthlimit 384m
    setprop dalvik.vm.heapsize 512m
    setprop dalvik.vm.heaptargetutilization 0.75
    setprop dalvik.vm.heapminfree 16m
    setprop dalvik.vm.heapmaxfree 64m
    setprop dalvik.vm.usap_pool_enabled true
    setprop dalvik.vm.usap_pool_size_max 5
    setprop dalvik.vm.madvise.vdexfile.size 209715200
    setprop dalvik.vm.madvise.odexfile.size 209715200

